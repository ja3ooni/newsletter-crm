{
  "name": "@ailert/analytics-service",
  "version": "1.0.0",
  "description": "Analytics Service with comprehensive metrics and reporting",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "jest --silent",
    "test:watch": "jest --watch --silent",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "type-check": "tsc --noEmit",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "docs": "typedoc src/index.ts",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "pg": "^8.11.3",
    "redis": "^4.6.10",
    "winston": "^3.11.0",
    "dotenv": "^16.3.1",
    "zod": "^3.22.4",
    "uuid": "^9.0.1",
    "ws": "^8.14.2",
    "bull": "^4.12.2",
    "node-cron": "^3.0.3",
    "date-fns": "^2.30.0",
    "lodash": "^4.17.21",
    "ml-matrix": "^6.10.7",
    "ml-regression": "^5.0.0",
    "ml-kmeans": "^6.0.0",
    "simple-statistics": "^7.8.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "@types/jest": "^29.5.8",
    "@types/supertest": "^2.0.16",
    "@types/ws": "^8.5.10",
    "@types/node-cron": "^3.0.11",
    "@types/lodash": "^4.14.202",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "supertest": "^6.3.3",
    "tsx": "^4.6.0",
    "typescript": "^5.3.2",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "typedoc": "^0.25.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
