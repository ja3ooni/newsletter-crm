# Server Configuration
NODE_ENV=development
PORT=3005
LOG_LEVEL=info

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=datatechtoncrm_billing
DB_USER=postgres
DB_PASSWORD=password
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
DEFAULT_CURRENCY=usd

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=24h

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Redis Configuration (for caching and queues)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=noreply@yourdomain.com

# Webhook URLs (for notifying other services)
USER_SERVICE_WEBHOOK_URL=http://localhost:3001/api/v1/webhooks/billing
NEWSLETTER_SERVICE_WEBHOOK_URL=http://localhost:3002/api/v1/webhooks/billing

# Feature Flags
ENABLE_DUNNING=true
ENABLE_USAGE_TRACKING=true
ENABLE_PROMO_CODES=true

# Monitoring
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=
