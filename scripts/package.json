{
  "name": "@datatechtoncrm/developer-tools",
  "version": "1.0.0",
  "description": "Developer tools and utilities for DatatechtonCRM platform",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only debug-tools.ts",
    "start": "node dist/debug-tools.js",
    "lint": "eslint **/*.ts",
    "lint:fix": "eslint **/*.ts --fix",
    "format": "prettier --write **/*.ts",
    "type-check": "tsc --noEmit",
    "quality-check": "npm run lint && npm run type-check && npm run format -- --check",
    "test": "jest --silent",
    "test:watch": "jest --watch --silent",
    "test:coverage": "jest --coverage --silent",
    "test:ci": "jest --ci --coverage --silent --maxWorkers=2",
    "test:unit": "jest --testPathPatterns=__tests__ --testPathIgnorePatterns=integration --silent",
    "test:integration": "node run-integration-tests.js",
    "test:integration:full": "jest --config=__tests__/integration/jest.integration.config.js --runInBand --silent",
    "test:integration:watch": "jest --config=__tests__/integration/jest.integration.config.js --watch",
    "test:platform": "jest --testPathPatterns=platform --silent",
    "test:performance": "jest --testPathPatterns=performance-regression --silent",
    "test:smoke": "jest --testPathPatterns=smoke --silent",
    "test:aggregate": "node scripts/aggregate-test-results.js",
    "coverage:check": "node scripts/check-coverage-threshold.js",
    "coverage:report": "jest --coverage --coverageReporters=html,lcov,text-summary --silent",
    "performance:analyze": "node scripts/analyze-performance.js",
    "security:scan": "node scripts/security-scan.js",
    "security:audit": "npm audit --registry https://registry.npmjs.org/",
    "security:update": "npm update && npm audit --registry https://registry.npmjs.org/",
    "quality:gates": "node scripts/quality-gates.js",
    "report:generate": "node scripts/generate-report.js",
    "deploy:staging": "echo 'Deploying to staging environment...'",
    "ci:full": "npm run quality-check && npm run test:coverage && npm run test:integration:full && npm run test:performance && npm run security:scan"
  },
  "dependencies": {
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "jest": "^30.2.0",
    "jest-html-reporters": "^3.1.7",
    "jest-junit": "^16.0.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "datatechtoncrm",
    "developer-tools",
    "debugging",
    "typescript"
  ],
  "author": "DatatechtonCRM Team",
  "license": "MIT"
}
