# Test Environment Configuration

# Environment
NODE_ENV=test

# Database
DATABASE_URL=postgresql://testuser:testpassword@localhost:5432/ailert_test
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ailert_test
DB_USER=testuser
DB_PASSWORD=testpassword

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# API Configuration
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
API_PORT=8000

# Authentication
JWT_SECRET=test-jwt-secret-key-for-testing-only
JWT_REFRESH_SECRET=test-refresh-secret-key-for-testing-only
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Test Users
TEST_ADMIN_EMAIL=admin@test.com
TEST_ADMIN_PASSWORD=TestPassword123!
TEST_USER_EMAIL=user@test.com
TEST_USER_PASSWORD=TestPassword123!

# Email (Test Mode)
EMAIL_PROVIDER=test
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test
SMTP_PASSWORD=test
FROM_EMAIL=test@ailert.com

# External Services (Mock/Test)
STRIPE_SECRET_KEY=sk_test_mock_key
STRIPE_WEBHOOK_SECRET=whsec_test_mock_secret
OPENAI_API_KEY=test-openai-key
GITHUB_TOKEN=test-github-token

# AWS (LocalStack for testing)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
S3_BUCKET=test-ailert-bucket

# Monitoring (Disabled in tests)
PROMETHEUS_ENABLED=false
GRAFANA_ENABLED=false
JAEGER_ENABLED=false

# Logging
LOG_LEVEL=error
LOG_FORMAT=json

# Rate Limiting (Relaxed for tests)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# Testing Flags
START_TEST_INFRASTRUCTURE=false
ENABLE_TEST_ROUTES=true
MOCK_EXTERNAL_SERVICES=true
TEST_TIMEOUT=30000

# Performance Testing
LOAD_TEST_USERS=10
LOAD_TEST_DURATION=30s
LOAD_TEST_RPS=50

# Security Testing
SECURITY_SCAN_ENABLED=true
VULNERABILITY_THRESHOLD=medium
