# DatatechtonCRM Development Environment Variables
# Copy this file to .env and update the values as needed

# Environment
NODE_ENV=development
DEBUG=true

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=datatechtoncrm
POSTGRES_USER=datatechtoncrm
POSTGRES_PASSWORD=datatechtoncrm_dev_password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=datatechtoncrm_redis_password

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=datatechtoncrm
RABBITMQ_PASSWORD=datatechtoncrm_rabbitmq_password

# Elasticsearch Configuration
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL=http://localhost:9200

# JWT Configuration
JWT_SECRET=dev_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# SMTP Configuration (for development - use Mailhog or similar)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@datatechtoncrm.dev
SMTP_FROM_NAME=DatatechtonCRM Development

# AWS Configuration (optional for development)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=datatechtoncrm-dev-storage

# API Configuration
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
CORS_ORIGIN=http://localhost:3000

# Service Ports
USER_SERVICE_PORT=3001
NEWSLETTER_SERVICE_PORT=3002
CONTENT_SERVICE_PORT=3003
CRM_SERVICE_PORT=3004
ANALYTICS_SERVICE_PORT=3005
FRONTEND_PORT=3000

# Monitoring Configuration
GRAFANA_PASSWORD=admin
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# External APIs (optional)
OPENAI_API_KEY=
SENDGRID_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
LOG_FORMAT=combined

# Security
BCRYPT_ROUNDS=10
SESSION_SECRET=dev_session_secret_change_in_production

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_CRM=true
ENABLE_AUTOMATION=true
ENABLE_PREMIUM_FEATURES=true

# Development Tools
ENABLE_SWAGGER=true
ENABLE_PLAYGROUND=true
ENABLE_DEBUG_ROUTES=true