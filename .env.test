# Test Environment Variables
NODE_ENV=test
DEBUG=false

# Test Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ailert_test
POSTGRES_USER=ailert_test
POSTGRES_PASSWORD=ailert_test_password

# Test Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=ailert_test_redis_password

# Test RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5673
RABBITMQ_USER=ailert_test
RABBITMQ_PASSWORD=ailert_test_rabbitmq_password

# Test Elasticsearch Configuration
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9201
ELASTICSEARCH_URL=http://localhost:9201

# Test JWT Configuration
JWT_SECRET=test_jwt_secret_for_testing_only
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Test SMTP Configuration (use Mailhog or mock)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=test@ailert.test
SMTP_FROM_NAME=AiLert Test

# Test API Configuration
API_URL=http://localhost:8001
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1
CORS_ORIGIN=http://localhost:3001

# Test Service Ports
USER_SERVICE_PORT=3011
NEWSLETTER_SERVICE_PORT=3012
CONTENT_SERVICE_PORT=3013
CRM_SERVICE_PORT=3014
ANALYTICS_SERVICE_PORT=3015
FRONTEND_PORT=3001

# Test Infrastructure Control
START_TEST_INFRASTRUCTURE=true
CLEANUP_TEST_DATA=true

# Test Logging
LOG_LEVEL=error
LOG_FORMAT=json

# Test Security
BCRYPT_ROUNDS=4  # Lower for faster tests
SESSION_SECRET=test_session_secret

# Test Feature Flags
ENABLE_ANALYTICS=false
ENABLE_CRM=false
ENABLE_AUTOMATION=false
ENABLE_PREMIUM_FEATURES=false

# Test Rate Limiting (more permissive)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# Test Timeouts (shorter for faster tests)
REQUEST_TIMEOUT=5000
DATABASE_TIMEOUT=3000
REDIS_TIMEOUT=2000

# Test File Uploads
MAX_FILE_SIZE=1048576  # 1MB for tests
UPLOAD_DIR=tmp/test-uploads

# Test External APIs (use mocks)
OPENAI_API_KEY=test_openai_key
SENDGRID_API_KEY=test_sendgrid_key
STRIPE_SECRET_KEY=test_stripe_key
STRIPE_PUBLISHABLE_KEY=test_stripe_pk

# Test Monitoring (disabled)
ENABLE_METRICS=false
ENABLE_TRACING=false
ENABLE_PROFILING=false
