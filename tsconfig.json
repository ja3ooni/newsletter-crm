{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "allowJs": true,
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./shared/*"],
      "@types/*": ["./types/*"]
    }
  },
  "include": ["src/**/*", "types/**/*", "shared/**/*", "services/shared/**/*", "*.ts", "*.js"],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "**/*.test.ts",
    "**/*.spec.ts",
    "services/*/node_modules",
    "services/*/dist",
    "services/*/src",
    "frontend/node_modules",
    "frontend/.next",
    "frontend/src"
  ],
  "references": [
    {
      "path": "./services/shared"
    },
    {
      "path": "./services/user-service"
    },
    {
      "path": "./services/newsletter-service"
    },
    {
      "path": "./services/content-service"
    },
    {
      "path": "./services/crm-service"
    },
    {
      "path": "./services/analytics-service"
    },
    {
      "path": "./services/marketing-automation-service"
    },
    {
      "path": "./frontend"
    }
  ]
}
